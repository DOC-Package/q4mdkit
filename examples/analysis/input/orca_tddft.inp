# ORCA TD-DFT input template
# Coordinates will be appended at the end

! B3LYP def2-SVP TightSCF
! TDDFT

%pal
  nprocs {NPROCS}
end

%maxcore {MEMORY}

%tddft
  nroots {NROOTS}
  maxdim 5
  tda false           # Full TD-DFT (not TDA)
  # triplets false    # Singlets only
end

%scf
  MaxIter 200
  ConvForced true     # Force convergence even if slow
end

# Geometry will be added below
* xyz 0 1
{XYZ_FILE}
*
