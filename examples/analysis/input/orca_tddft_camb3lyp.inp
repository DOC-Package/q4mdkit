# ORCA TD-DFT input template with CAM-B3LYP
# Long-range corrected functional for better CT states

! CAM-B3LYP def2-SVP TightSCF
! TDDFT

%pal
  nprocs {NPROCS}
end

%maxcore {MEMORY}

%tddft
  nroots {NROOTS}
  maxdim 5
  tda false
end

%scf
  MaxIter 200
  ConvForced true
end

* xyz 0 1
{XYZ_FILE}
*
