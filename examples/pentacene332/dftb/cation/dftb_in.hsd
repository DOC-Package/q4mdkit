Geometry = GenFormat {
  <<< "geom.out.gen"
}

Hamiltonian = DFTB {
  SpinPolarisation {
    Colinear {
      UnpairedElectrons = 1
      InitialSpins = {
        AtomSpin {
          Atoms = 1:36
          SpinPerAtom = +0.028
        }
      }
    }
  }
  SpinConstants {
    ShellResolvedSpin = Yes
    H {
      -0.07174
    }
    C {
      -0.03062  -0.02505
      -0.02505  -0.02265
    }
  }
  Charge = 1
  HCorrection = Damping {
    Exponent = 4.0
  }
  Scc = Yes
  SCCTolerance = 1e-10
  MaxSCCIterations = 500
  ThirdOrderFull = Yes
  ThirdOrder = No
  HubbardDerivs {
    H = -0.1857
    C = -0.1492
  }
  SlaterKosterFiles {
    C-C = '/home/takahashi/qmmm/sk/3ob/C-C.skf'
    C-H = '/home/takahashi/qmmm/sk/3ob/C-H.skf'
    H-C = '/home/takahashi/qmmm/sk/3ob/H-C.skf'
    H-H = '/home/takahashi/qmmm/sk/3ob/H-H.skf'
  }
  MaxAngularMomentum {
    C = "p"
    H = "s"
  }
  Mixer = Broyden {
    MixingParameter = 0.2
  }
  ReadInitialCharges = No
}

Driver = SecondDerivatives {
    delta = 5e-4
}

Analysis {
  PrintForces = Yes
  WriteEigenvectors = Yes
  EigenvectorsAsText = Yes
  WriteBandOut = Yes
  MullikenAnalysis = Yes
  WriteNetCharges = Yes
}

ParserOptions {
  ParserVersion = 14
}

Options {
  WriteDetailedOut = Yes
  WriteDetailedXml = No
  WriteAutotestTag = No
  WriteResultsTag = No
  RestartFrequency = 20
  RandomSeed = 0
  TimingVerbosity = 1
  WriteCharges = Yes
  WriteHS = No
}
