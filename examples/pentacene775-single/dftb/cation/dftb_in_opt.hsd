Geometry = GenFormat {
<<< 'geom_neutral.gen'
}

Hamiltonian = DFTB {
  ElectricField = {
    PointCharges = {
      GaussianBlurWidth [Angstrom] = 0.0
      CoordsAndCharges [Angstrom] = DirectRead {
        Records = 17604
        File = 'PCcharges.dat'
      }
    }
  }
  SpinPolarisation {
    Colinear {
      UnpairedElectrons = 1
      InitialSpins = {
        AtomSpin {
          Atoms = 1:36
          SpinPerAtom = +0.028
        }
      }
    }
  }
  SpinConstants {
    ShellResolvedSpin = Yes
    H {
      -0.07174
    }
    C {
      -0.03062  -0.02505
      -0.02505  -0.02265
    }
  }
  Charge = 1
  HCorrection = Damping {
    Exponent = 4.0
  }
  Scc = Yes
  SCCTolerance = 1e-6
  MaxSCCIterations = 1000
  ThirdOrderFull = Yes
  ThirdOrder = No
  HubbardDerivs {
    H = -0.1857
    C = -0.1492
  }
  SlaterKosterFiles {
    C-C = '/home/takahashi/qmmm/sk/3ob/C-C.skf'
    C-H = '/home/takahashi/qmmm/sk/3ob/C-H.skf'
    H-C = '/home/takahashi/qmmm/sk/3ob/H-C.skf'
    H-H = '/home/takahashi/qmmm/sk/3ob/H-H.skf'
  }
  MaxAngularMomentum {
    C = "p"
    H = "s"
  }
  Mixer = Broyden {
    MixingParameter = 0.02
  }
  ReadInitialCharges = No
}

Driver = GeometryOptimization {
  Optimizer = Rational {}
  MovedAtoms = 1:-1
  MaxSteps = 1000
  OutputPrefix = "geom.out"
  Convergence {
    Energy = 1e-5
    GradElem = 5e-3
    GradNorm = 5e-3
    DispElem = 5e-3
    DispNorm = 5e-3
  }
  AppendGeometries = Yes
}

Analysis {
  PrintForces = Yes
  WriteEigenvectors = Yes
  EigenvectorsAsText = Yes
  WriteBandOut = Yes
  MullikenAnalysis = Yes
  WriteNetCharges = Yes
}

ParserOptions {
  ParserVersion = 14
}

Options {
  WriteDetailedOut = Yes
  WriteDetailedXml = No
  WriteAutotestTag = No
  WriteResultsTag = No
  RandomSeed = 0
  TimingVerbosity = 1
  WriteCharges = Yes
  WriteHS = No
}
