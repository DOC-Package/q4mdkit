# ============================================================
# Toggle labels function
# ============================================================
proc toggle_labels {} {
    set num_graphics [graphics top list]
    if {[llength $num_graphics] > 0} {
        graphics top delete all
        puts "Labels hidden"
    } else {
        source /home/takahashi/python/q4mdkit/examples/pentacene775-single/input/visualize_nearby.tcl
        puts "Labels shown (reloading script)"
    }
}

# ============================================================
# Viewpoint save/restore functions
# ============================================================
proc save_viewpoint {{filename "/home/takahashi/python/q4mdkit/examples/pentacene775-single/input/viewpoint_nearby.tcl"}} {
    set fp [open $filename w]
    puts $fp "# VMD viewpoint settings - auto-generated"
    puts $fp "molinfo top set {rotate_matrix} {[molinfo top get rotate_matrix]}"
    puts $fp "molinfo top set {center_matrix} {[molinfo top get center_matrix]}"
    puts $fp "molinfo top set {scale_matrix} {[molinfo top get scale_matrix]}"
    puts $fp "molinfo top set {global_matrix} {[molinfo top get global_matrix]}"
    close $fp
    puts "Viewpoint saved to: $filename"
}

proc load_viewpoint {{filename "/home/takahashi/python/q4mdkit/examples/pentacene775-single/input/viewpoint_nearby.tcl"}} {
    if {[file exists $filename]} {
        source $filename
        puts "Viewpoint loaded from: $filename"
    } else {
        puts "Viewpoint file not found: $filename"
    }
}

