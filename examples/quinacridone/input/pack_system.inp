tolerance 2.0
filetype pdb
output quinacridone_dmso.pdb

# Solute
structure ../quinacridone.pdb
  number 1
  center
  fixed 17.4 17.4 17.4 0. 0. 0.
  resnumbers 2
end structure

# Solvent
structure ../../solvent/dmso/dmso.pdb
  number 340
  inside box 0. 0. 0. 34.8 34.8 34.8
  resnumbers 2
end structure
