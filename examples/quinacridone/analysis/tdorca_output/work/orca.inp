# ORCA TD-DFT template for Quinacridone (C20H12N2O2)
# 36 atoms, neutral singlet

! B3LYP def2-SVP D3BJ TightSCF NoAutoStart

%pal
  nprocs 1
end

%maxcore 4000

%tddft
  nroots 10
  maxdim 10           # Increased for better convergence
  tda true            # TDA for stable convergence
  printlevel 3        # Print more TD-DFT output
end

%scf
  MaxIter 300
  ConvForced true
end

