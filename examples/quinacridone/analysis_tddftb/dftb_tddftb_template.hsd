# DFTB+ TD-DFTB (Linear Response) Template for Quinacridone
# Use with q4mdkit.analysis.tddftb module

# Note: Geometry section is added by the analysis script
# Geometry = xyzFormat {
#   <<< "qm_coords.xyz"
# }

Hamiltonian = DFTB {
  Scc = Yes
  MaxSCCIterations = 300
  SccTolerance = 1e-6
  
  # Note: ThirdOrderFull/HubbardDerivs are incompatible with TD-DFTB
  # Using standard DFTB2 for excited state calculations
  
  SlaterKosterFiles {
    C-C = '/home/takahashi/qmmm/sk/3ob/C-C.skf'
    C-H = '/home/takahashi/qmmm/sk/3ob/C-H.skf'
    H-C = '/home/takahashi/qmmm/sk/3ob/H-C.skf'
    H-H = '/home/takahashi/qmmm/sk/3ob/H-H.skf'
    C-N = '/home/takahashi/qmmm/sk/3ob/C-N.skf'
    N-C = '/home/takahashi/qmmm/sk/3ob/N-C.skf'
    N-N = '/home/takahashi/qmmm/sk/3ob/N-N.skf'
    N-H = '/home/takahashi/qmmm/sk/3ob/N-H.skf'
    H-N = '/home/takahashi/qmmm/sk/3ob/H-N.skf'
    C-O = '/home/takahashi/qmmm/sk/3ob/C-O.skf'
    O-C = '/home/takahashi/qmmm/sk/3ob/O-C.skf'
    O-O = '/home/takahashi/qmmm/sk/3ob/O-O.skf'
    N-O = '/home/takahashi/qmmm/sk/3ob/N-O.skf'
    O-N = '/home/takahashi/qmmm/sk/3ob/O-N.skf'
    H-O = '/home/takahashi/qmmm/sk/3ob/H-O.skf'
    O-H = '/home/takahashi/qmmm/sk/3ob/O-H.skf'
  }
  
  MaxAngularMomentum {
    C = "p"
    H = "s"
    O = "p"
    N = "p"
  }
}

# TD-DFTB using Casida (Linear Response)
ExcitedState = {
  Casida = {
    NrOfExcitations = 10      # Will be updated by script
    Symmetry = Singlet
    WriteTransitions = Yes
    WriteMulliken = Yes
    WriteTransitionDipole = Yes
    Diagonaliser = Stratmann {}
  }
}

Options {
  WriteDetailedOut = Yes
}

Analysis {
  WriteEigenvectors = Yes
}

ParserOptions {
  ParserVersion = 14
}
