Geometry = xyzFormat {
<<< 'dftb_.xyz' 
}
Hamiltonian = DFTB {
ElectricField = { 
  PointCharges = { 
    GaussianBlurWidth [Angstrom] = 0.0
    CoordsAndCharges [Angstrom] = DirectRead { 
    Records = 3400
    File = 'PCcharges.dat'
    }
  }
}
  HCorrection  = Damping {
   Exponent = 4.0
   }
  Scc = Yes
  MaxSCCIterations = 300
  ThirdOrderFull = Yes
  ThirdOrder = No
  HubbardDerivs {
    H = -0.1857
    C = -0.1492
    N = -0.1535
    O = -0.1575
   }
  SlaterKosterFiles {
    C-C = '/home/takahashi/qmmm/sk/3ob/C-C.skf'
    C-H = '/home/takahashi/qmmm/sk/3ob/C-H.skf'
    H-C = '/home/takahashi/qmmm/sk/3ob/H-C.skf'
    H-H = '/home/takahashi/qmmm/sk/3ob/H-H.skf'
    C-N = '/home/takahashi/qmmm/sk/3ob/C-N.skf'
    N-C = '/home/takahashi/qmmm/sk/3ob/N-C.skf'
    N-N = '/home/takahashi/qmmm/sk/3ob/N-N.skf'
    N-H = '/home/takahashi/qmmm/sk/3ob/N-H.skf'
    H-N = '/home/takahashi/qmmm/sk/3ob/H-N.skf'
    C-O = '/home/takahashi/qmmm/sk/3ob/C-O.skf'
    O-C = '/home/takahashi/qmmm/sk/3ob/O-C.skf'
    O-O = '/home/takahashi/qmmm/sk/3ob/O-O.skf'
    N-O = '/home/takahashi/qmmm/sk/3ob/N-O.skf'
    O-N = '/home/takahashi/qmmm/sk/3ob/O-N.skf'
    H-O = '/home/takahashi/qmmm/sk/3ob/H-O.skf'
    O-H = '/home/takahashi/qmmm/sk/3ob/O-H.skf'
  }
  MaxAngularMomentum {
    C = "p"
    H = "s"
    O = "p"
    N = "p"
  }
}
Options { WriteDetailedOut = Yes }
ParserOptions { ParserVersion = 10 }
Analysis { PrintForces = Yes }
