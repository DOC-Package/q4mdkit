    O-H = '/home/takahashi/qmmm/sk/opv/b3lyp/O-H.skf'
  }
  MaxAngularMomentum {
    C = "p"
    N = "p"
    H = "s"
    O = "p"
  }
  Dispersion = DFTD3 {
    Damping = BeckeJohnson {
      a1 = 0.497
      a2 = 3.622
    }
    s6 = 1.0
    s8 = 0.01
