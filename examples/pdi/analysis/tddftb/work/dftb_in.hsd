Geometry {
  xyzFormat {
    <<< "qm_coords.xyz"
  }
}

Hamiltonian {
  DFTB {
    Scc = Yes
    SccTolerance = 1e-05
    MaxSccIterations = 300
    ThirdOrderFull = No
    ThirdOrder = No
    SlaterKosterFiles {
      C-C = '/home/takahashi/qmmm/sk/mio/C-C.skf'
      C-H = '/home/takahashi/qmmm/sk/mio/C-H.skf'
      H-C = '/home/takahashi/qmmm/sk/mio/H-C.skf'
      H-H = '/home/takahashi/qmmm/sk/mio/H-H.skf'
      C-N = '/home/takahashi/qmmm/sk/mio/C-N.skf'
      N-C = '/home/takahashi/qmmm/sk/mio/N-C.skf'
      N-N = '/home/takahashi/qmmm/sk/mio/N-N.skf'
      N-H = '/home/takahashi/qmmm/sk/mio/N-H.skf'
      H-N = '/home/takahashi/qmmm/sk/mio/H-N.skf'
      C-O = '/home/takahashi/qmmm/sk/mio/C-O.skf'
      O-C = '/home/takahashi/qmmm/sk/mio/O-C.skf'
      O-O = '/home/takahashi/qmmm/sk/mio/O-O.skf'
      N-O = '/home/takahashi/qmmm/sk/mio/N-O.skf'
      O-N = '/home/takahashi/qmmm/sk/mio/O-N.skf'
      H-O = '/home/takahashi/qmmm/sk/mio/H-O.skf'
      O-H = '/home/takahashi/qmmm/sk/mio/O-H.skf'
    }
    MaxAngularMomentum {
      C = "p"
      O = "p"
      N = "p"
      H = "s"
    }
    Dispersion {
      DFTD3 {
        Damping {
          BeckeJohnson {
            a1 = 0.4289
            a2 = 4.4407
          }
        }
        s6 = 1.0
        s8 = 0.7875
      }
    }
    Mixer {
      Broyden {
        MixingParameter = 0.01
      }
    }
    ReadInitialCharges = No
  }
}
ExcitedState {
  Casida {
    NrOfExcitations = 10
    Symmetry = Singlet
    WriteTransitions = Yes
    Diagonaliser {
      Stratmann {}
    }
  }
}
Analysis {
  PrintForces = No
  WriteEigenvectors = Yes
  EigenvectorsAsText = Yes
  WriteBandOut = Yes
  MullikenAnalysis = Yes
  WriteNetCharges = Yes
}
ParserOptions {
  ParserVersion = 14
}
Options {
  WriteDetailedOut = Yes
  WriteDetailedXml = No
  WriteAutotestTag = No
  WriteResultsTag = No
  RestartFrequency = 20
  RandomSeed = 0
  TimingVerbosity = 1
  WriteCharges = Yes
  WriteHS = No
}
