#!/usr/bin/env python3
"""Convenience wrapper to run cif2crd.py from any directory."""
import sys
import os
from pathlib import Path

# Get project root (parent of bin/)
project_root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(project_root / "src"))

# Import and run the actual script
if __name__ == "__main__":
    tool_path = project_root / "src" / "engines" / "pycharmm" / "cif2crd.py"
    with open(tool_path) as f:
        code = compile(f.read(), tool_path, 'exec')
        exec(code)
